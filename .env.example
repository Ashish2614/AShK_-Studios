# =====================================================================
# AShK Stays - Environment Variables Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# NEVER commit .env to public version control.
# =====================================================================

# Application & Hosting URLs
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Server-only key with administrative DB privileges (Never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ---------------------------------------------------------------------
# Resend Transactional Email Configuration
# ---------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=concierge@ashkstays.com
OWNER_EMAIL=ashishtring@gmail.com

# ---------------------------------------------------------------------
# Gmail API (OAuth 2.0 Client & Refresh Token)
# ---------------------------------------------------------------------
GMAIL_CLIENT_ID=your_gmail_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here
GMAIL_USER_EMAIL=your_email@gmail.com

# ---------------------------------------------------------------------
# Razorpay India Payment Gateway (INR, UPI, Cards, Netbanking)
# ---------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ---------------------------------------------------------------------
# Stripe International Payment Gateway
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ---------------------------------------------------------------------
# Security & Rate Limiting
# ---------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS_PER_MIN=15
